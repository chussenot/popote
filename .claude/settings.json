{
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(mise run:*)",
      "Bash(mise tasks:*)",
      "Bash(mise ls:*)",
      "Bash(prek run:*)",
      "Bash(cog check:*)",
      "Bash(cog verify:*)",
      "Bash(cog changelog:*)",
      "Bash(shellcheck:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python3 scripts/docs.py:*)",
      "Bash(bd ready:*)",
      "Bash(bd show:*)",
      "Bash(bd list:*)",
      "Bash(bd search:*)",
      "Bash(bd create:*)",
      "Bash(bd update:*)",
      "Bash(bd close:*)",
      "Bash(bd dep:*)",
      "Bash(bd remember:*)",
      "Bash(bd memories:*)",
      "Bash(bd prime:*)",
      "Bash(pact whoami:*)",
      "Bash(pact doctor:*)",
      "Bash(pact lease:*)",
      "Bash(pact msg:*)",
      "Bash(pact agents:*)",
      "Bash(pact log:*)",
      "Bash(rtk proxy:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "bd prime --hook-json"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtk-rewrite.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-on-edit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/codegraph.sh\" prompt-hook 2>/dev/null || true # runs: codegraph prompt-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
